{
  "name": "macrofill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @macrofill/web --filter @macrofill/api dev",
    "build": "pnpm --filter @macrofill/web --filter @macrofill/api build",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "pnpm --filter @macrofill/api db:migrate",
    "db:seed": "pnpm --filter @macrofill/api db:seed",
    "db:password": "pnpm --filter @macrofill/api db:password",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @macrofill/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.2"
  }
}
