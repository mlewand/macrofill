# Copy to .env. Used by `pnpm dev` (api and Vite) and the db scripts.

# Local Postgres from `pnpm db:up`. To use an existing server instead, point this at
# the app's own database and role there; nothing else changes.
DATABASE_URL=postgres://macrofill:macrofill@localhost:5432/macrofill

# `pnpm test:e2e` uses its own database, wiped and reseeded on every run: by default
# DATABASE_URL's database with _e2e added (macrofill_e2e), created if missing. To use another
# one, set this; its name must end in _e2e.
# E2E_DATABASE_URL=postgres://macrofill:macrofill@localhost:5432/macrofill_e2e

# Initial login password for the seed user mlewand (M4-1), at least 8 characters. `pnpm db:seed`
# stores only its hash, and only while the user has no password; change it later with
# `pnpm db:password mlewand`. e2e sets its own.
SEED_PASSWORD_MLEWAND=

# api dev server; Vite proxies /api to it.
API_PORT=3000

# Testing on the phone through the HTTPS reverse proxy (Caddy on another LAN machine).
# Leave empty for localhost-only development.
# DEV_HOST=0.0.0.0
# TODO: set to the proxy's hostname(s) for the dev site, comma-separated.
# DEV_ALLOWED_HOSTS=
# DEV_HMR_CLIENT_PORT=443

# Looking up an unknown barcode in Open Food Facts (#66), then USDA FoodData Central (#67). All
# optional.
# How long one product database may take before the lookup goes on without it, in ms (1 to 20000).
# LOOKUP_TIMEOUT_MS=5000
# How long the whole lookup may take, all databases together, in ms (1 to 20000).
# LOOKUP_TOTAL_TIMEOUT_MS=10000
# USDA FoodData Central is only asked with a key: free, from https://api.data.gov/signup/ (1000
# requests per hour). Without one the lookup is Open Food Facts alone.
# USDA_API_KEY=
# USDA_API_URL=https://api.nal.usda.gov
# The contact in the User-Agent that Open Food Facts asks for: Macrofill/<version> (<contact>).
# LOOKUP_CONTACT=macrofill_app@mlewandowski.com
# Where Open Food Facts is. Tests and e2e point this at a local stub; they never call the real one.
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
